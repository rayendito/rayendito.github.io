---
import kitty from '../../kitty.txt?raw';
---

<pre class="ascii-cat" aria-hidden="true">{kitty.trimEnd()}</pre>

<style>
	.ascii-cat {
		position: absolute;
		top: 1rem;
		right: max(-3rem, calc((100vw - 68rem) / 2));
		z-index: 0;
		margin: 0;
		color: rgb(168 162 158 / 38%);
		font-size: clamp(6px, 0.72vw, 10px);
		line-height: 0.9;
		letter-spacing: 0;
		white-space: pre;
		pointer-events: none;
		user-select: none;
	}

	@media (max-width: 640px) {
		.ascii-cat {
			top: 4rem;
			right: -6rem;
			font-size: 7px;
		}
	}
</style>
