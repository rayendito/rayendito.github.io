---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import LatestPosts from '@/components/LatestPosts.astro';
import AsciiCat from '@/components/AsciiCat.astro';
import Section from '@/components/Section.astro';
import { sortPostsByDate } from '@/utils/data.util';
import { MarkdownInstance } from 'astro';

const { title } = AppConfig;
const { description } = AppConfig;

const allPosts = Object.values(
	import.meta.glob('./posts/*.md', { eager: true })
) as MarkdownInstance<any>[];
allPosts.sort(sortPostsByDate);
const latestPosts = allPosts.slice(0, 3);
---

<Base head={{ title, description }}>
	<main class="relative isolate overflow-hidden">
		<AsciiCat />
		<div class="relative z-10">
			<Hero />
			<LatestPosts posts={latestPosts} />
			<Section>
				<blockquote class="text-sm italic text-stone-300">
					<p>
						“The number of hours we have together is actually not so large. Please linger near the
						door uncomfortably instead of just leaving. Please forget your scarf in my life and come
						back later for it.”
					</p>
					<footer class="mt-3 not-italic text-stone-400">
						― <cite class="not-italic text-stone-300">Mikko Harvey</cite>
					</footer>
				</blockquote>
			</Section>
		</div>
	</main>
</Base>
